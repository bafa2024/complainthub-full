    transform: none;
  }
}

/* Touch target improvements for mobile */
@media (max-width: 768px) {
  .btn {
    min-height: 48px;
    padding: 0.875rem 1.5rem;
  }
  
  .btn-lg {
    min-height: 52px;
    padding: 1.125rem 2rem;
  }
  
  .feature-card,
  .step,
  .testimonial-card,
  .pricing-card {
    min-height: 200px;
  }
}

/* Hide/show utilities */
.hidden-mobile {
  display: none;
}

.desktop-only {
  display: none;
}

@media (min-width: 768px) {
  .hidden-mobile {
    display: block;
  }
  
  .desktop-only {
    display: block;
  }
  
  .mobile-only {
    display: none;
  }
}

/* Accessibility improvements */
@media (prefers-reduced-motion: reduce) {
  .floating-card,
  .feature-card,
  .step,
  .testimonial-card,
  .pricing-card,
  .btn {
    animation: none;
    transition: none;
  }
}

